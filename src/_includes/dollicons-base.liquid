      <a href="{{ "dollicons/chalice.liquid" | inputPathToUrl }}" class="icon">󰋕</a>
      <a href="{{ "dollicons.liquid" | inputPathToUrl }}">
        <image src="/android-chrome-192x192.png" alt="Dingir" class="logo icon">
      </a>
      <a href="#" class="icon">󱢲</a>
      <a href="#" class="icon">󱀝</a>
    </header>
    <main>{{ content }}</main>
  </body>
</html>
